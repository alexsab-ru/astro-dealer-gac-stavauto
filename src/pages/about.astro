---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/site/settings.json';
import Banner from '@/blocks/banner/Banner.astro';
import BrandHistoryElements from '@/blocks/brand-history/BrandHistoryElements.astro';
import InfoSectionWithImage from '@/blocks/info-section-with-image/InfoSectionWithImage.astro';
import AdvantagesList from '@/blocks/advantages/AdvantagesList.astro';
import FaqItem from '@/blocks/faq/FaqItem.astro';
const { brand, legal_city_where } = settings;
const history = [
	{year: "1997", html: "<strong>Основание GAC GROUP</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/1997.webp\" alt=\"1997\" />"},
	{year: "2004", html: "<strong>Основание совместного предприятия GAC Toyota</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2004.webp\" alt=\"\" />"},
	{year: "2006", html: "<strong>Первая модель Toyota Camry GAC сошла с конвейера, ознаменовав запуск производства автомобилей</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2006.webp\" alt=\"\" />"},
	{year: "2008", html: "<strong>Основание компании GAC MOTOR</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2008.webp\" alt=\"\" />"},
	{year: "2010", html: "<strong>Выпущен первый автомобиль GAC Haixinsta</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2010.webp\" alt=\"\" />"},
	{year: "2017", html: "<strong>Выпущен 1 000 000 автомобиль</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2017.webp\" alt=\"\" />"},
	{year: "2018", html: "<strong>GAC участвует в ММАС (Московский международный автомобильный салон) в Москве</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2018.webp\" alt=\"\" />"},
	{year: "2019", html: "<strong>GAC представлен на рынке России</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2019.webp\" alt=\"\" />"},
	{year: "2020", html: "<ul><li>Презентация минивэна GN8 в России </li><li>Презентация кроссовера GS5 в России</li></ul><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2020.webp\" alt=\"\" />"},
	{year: "2021", html: "<strong>Запуск глобального слогана GO AND CHANGE</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2021.webp\" alt=\"\" />"},
	{year: "2022", html: "<ul><li>Начало работы пятого завода GAC Toyota</li><li>Суммарная производственная мощность достигает миллиона автомобилей в год</li></ul><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2022.webp\" alt=\"\" />"},
	{year: "2023", html: "<ul><li>Презентация флагманского кроссовера GS8 второго поколения в России</li><li>Совместно с властями Гуанчжоу, GAC Toyota запускает проект общественного транспорта на водородных топливных элементах</li></ul><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2023.webp\" alt=\"\" />"},
	{year: "2024", html: "<ul><li>Презентация премиального минивэна М8 в России </li><li>Презентация компактного кроссовера GS3 в России</li></ul><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2024.webp\" alt=\"\" />"},
	{year: "2025", html: "<strong>Презентация новых моделей GS4, Empow и GS8 Traveller</strong><br/><br/><img src=\"https://cdn.alexsab.ru/pages/gac/about/history/2025.webp\" alt=\"\" />"},
];
const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/gac/about/banner_desktop.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">О бренде</span></li></ol></nav><h1>О бренде</h1>",
}
const advantages = [ 
    {iconName: 'mdi:check-decagram', iconColor: 'text-accent-500', title: 'Качество'},
    {iconName: 'mdi:check-decagram', iconColor: 'text-accent-500', title: 'Безопасность'},
    {iconName: 'mdi:check-decagram', iconColor: 'text-accent-500', title: 'Надежность'},
];
const secrets = [
    {
        "id": 1,
        "question": "Компания из списка Fortune Global 500",
        "answer": "Уже 11  лет подряд мы попадаем в ежегодный рейтинг крупнейших компаний по объему выручки Fortune Global 500, каждый раз занимая все более высокие позиции. В 2023 году наша компания заняла 165‑е место.",
        "open": true
    },
    {
        "id": 2,
        "question": "Таланты со всего мира",
        "answer": "Мы собрали более 100 000 лучших специалистов из 15 стран мира и сформировали сильную команду разработчиков.",
        "open": false
    },
    {
        "id": 3,
        "question": "Запатентованные технологии мирового класса",
        "answer": "Компанией получено 18 600 независимых патентов, в том числе более 7 600 — на изобретения.",
        "open": false
    },
    {
        "id": 4,
        "question": "Лидеры отрасли по годовым объемам производства и продаж",
        "answer": "В течение 5 лет наши годовые объемы производства и продаж стабильно превышали 2 миллиона единиц. В 2023 году мы поставили рекорд компании, достигнув отметки в 2,5 миллиона.",
        "open": false
    },
    {
        "id": 5,
        "question": "Выдающееся мастерство и качество",
        "answer": "На протяжении 8 лет мы становились лидерами в области исследования качества китайских брендов (IQS). В 2023 году GAC AION стал единственным в мире заводом электромобилей, получившим престижный статус Lighthouse factory (статус «завода-маяка»).",
        "open": false
    },
    {
        "id": 6,
        "question": "Непрерывное развитие инноваций и НИОКР",
        "answer": "Мы инвестировали 6,5 миллиардов долларов в развитие инноваций и создали глобальную сеть центров исследований в пяти городах мира: в Китае, США и Италии. На данный момент центры исследований и разработок GAC оснащены самой эффективной системой тестирования транспортных средств в Китае.",
        "open": false
    },
];
---

<Layout title={`О бренде ${brand}`} description={`Компания GAC (полное название — GAC Motor Co., Ltd.) основана 21 июля 2008 года и входит в группу Guangzhou Automobile Group Co., Ltd. GAC — высокотехнологичное предприятие, ориентированное на производство и продажу автомобилей мирового уровня, двигателей, запчастей и авто аксессуаров к ним`} image="https://cdn.alexsab.ru/pages/gac/about/banner_desktop.webp">
	<Banner banners={[banner]} />

	<section class="bg-gray-50">
		<div class="container text-center">
			<h2 class="text-center mb-6">Наша миссия и философия</h2>
			<p>Уверенность за рулем — это не просто слова. Мы не только верим в надежность наших автомобилей, но и доказываем это.</p>
			<p>Наша основная задача — выстраивать прочные и долгосрочные отношения с клиентами, предлагая автомобили, которые станут лидерами на рынке.</p>
			<div class="lazy mt-10">
				<picture>
                    <source media="(max-width: 767px)" type="image/webp" srcset="https://cdn.alexsab.ru/pages/gac/about/1_mobile.webp" width="374" height="374">                            
                    <source type="image/webp" width="1280" height="720" srcset="https://cdn.alexsab.ru/pages/gac/about/1_desktop.webp">            
					<img src="https://cdn.alexsab.ru/pages/gac/about/1_desktop.webp" width="1920" height="1080" class="mx-auto" alt="Изображение на странице О бренде GAC MOTOR" loading="lazy">
				</picture>
			</div>
		</div>
	</section>
	<section class="bg-black text-white">
		<div class="container text-center">
			<p>GAC — один из крупнейших автопроизводителей Китая с богатой историей, известным качеством и масштабными планами на будущее. Мы всегда уверены в наших автомобилях и верим в их безопасность и надежность. В это верят и наши партнеры, с которыми мы эффективно сотрудничаем уже много лет. Наши автомобили — это залог бескомпромиссной уверенности, куда бы вы ни отправились. И именно это стало основой нашего нового слогана и главного принципа производства:</p>
			<br/>
			<p>GAC — ВСЕГДА УВЕРЕН!</p>
		</div>
	</section>
	<section>
		<div class="container text-center">
			<h2 class="text-center">Мы объединяем японские стандарты качества, статусный дизайн и особое внимание к деталям для истинной уверенности за рулем GAC</h2>
			<AdvantagesList items={advantages} classes="grid sm:grid-cols-3 gap-5 lg:gap-10 text-center mt-14" />
		</div>
	</section>
	<section class="bg-gray-50">
		<div class="container">
			<div class="text-center mb-10">
				<h2 class="mb-6">Наша история</h2>
				<p>Мы гордимся тем, что уже более 20 лет создаём качественные и инновационные решения для наших клиентов.</p>
			</div>
			<BrandHistoryElements items={history} />
		</div>
	</section>
	<section>
		<div class="container">
			<div class="text-center mb-10">
				<h2 class="mb-5">Наши ценности</h2>
				<p>«Качество, ответственность и самосовершенствование на первом месте».</p>
			</div>
			<div class="lazy">
				<video
					muted
					loop
					autoplay
					playsinline
					controls
					poster=https://cdn.alexsab.ru/pages/gac/about/poster.webp
					class="h-full w-full object-cover">
					<source data-src=https://cdn.alexsab.ru/video/gac/about.mp4 type="video/mp4" />
				</video>
			</div>
		</div>
	</section>
	<section>
		<div class="container">
			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/gac/about/2.webp',
			}}>
				<h3 class="font-bold mb-10">GAC x Toyota</h3>
				<div class="space-y-6 mb-10">
					<strong>В конце 2024 года исполнилось два десятилетия с момента, когда GAC Motor вступила в стратегическое партнерство с легендарной японской корпорацией Toyota Motor Co. Соглашение, подписанное 1 сентября 2004 года, стало ключевым этапом в развитии GAC, укрепив её позиции на глобальной автомобильной арене и подняв производственные стандарты компании до уровня мировых лидеров.</strong>
                    <p>Созданное в рамках этого сотрудничества совместное предприятие Guangzhou Toyota Motor Co., Ltd. изначально предусматривало долгосрочную перспективу — на 30 лет, и с самого начала отражало масштабные и амбициозные цели обеих компаний.</p>
					<p>На протяжении всей истории сотрудничества GAC Motor верна принципам качества и демонстрирует приверженность высоким стандартам, успешно внедряя основы философии Toyota: «Качество, ответственность и стремление к совершенству превыше всего».</p>
				</div>
			</InfoSectionWithImage>

			<InfoSectionWithImage image={{
				desktop: 'https://cdn.alexsab.ru/pages/gac/about/3.webp',
			}}>
				<h3 class="font-bold mb-10">Секрет нашего успеха</h3>
				<div x-data="{activities:[]}">
					{secrets.map(item => (
						<FaqItem item={item} />
					))}
				</div>
			</InfoSectionWithImage>
		</div>
	</section>
</Layout>